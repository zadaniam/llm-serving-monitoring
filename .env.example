# Template for environment variables. Copy this file to '.env' and replace
# placeholders with your actual secrets. Do not commit the actual '.env' file.

# --- LOCAL DEVELOPMENT CONFIGURATION ---
# LiteLLM Gateway Configuration
LITELLM_URL="http://localhost:4000"
LITELLM_MASTER_KEY="local-dev-secret-token"
REDIS_URL="redis://redis-local:6379/0"

# LiteLLM Cloud Provider API Keys
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_KEY_3_5="your_gemini_api_key_here"
GEMINI_KEY_2_5="your_gemini_api_key_here"

# --- PRODUCTION & CLOUD INFRASTRUCTURE ---
# Self-hosted vLLM configuration used in production environments
VLLM_API_BASE="http://vllm-mock:11434/v1"
VLLM_API_KEY="your_vllm_api_key_here"

# Google Cloud Run Deployment for LiteLLM Gateway
PROJECT_ID="352692367446"
PROJECT_ID_STRING="project-0cb13828-a08a-466a-934"
REGION="asia-southeast1"
GAR_REPO="llm-serving-monitoring"
WIF_PROVIDER="projects/352692367446/locations/global/workloadIdentityPools/github-pool-v2/providers/github-provider-v2"
